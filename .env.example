# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.
#   Copy-Item .env.example .env

# ── 두뇌 LLM ────────────────────────────────────────────────
# gemini | openai   (D-010: 기본은 gemini, 비교·시연용으로 openai)
LLM_PROVIDER=gemini

# 이미 Windows 환경변수에 있으면 여기 비워둬도 된다.
# 환경변수가 .env 보다 우선한다.
GEMINI_API_KEY=
# 여기서 시작해 한도(429)·과부하(503)를 만나면 폴백 사슬로 갈아탄다 (D-016).
# 사슬은 app/config.py 의 gemini_fallback_models 에 있다.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── 도구 ────────────────────────────────────────────────────
# Tavily: 무료 1,000크레딧/월, 카드 등록 불필요 (https://tavily.com)
TAVILY_API_KEY=

# ── LINE 발송 3중 잠금 (D-005) ──────────────────────────────
# 기본값은 dry-run. 실제 발송은 아래 스위치 + 사람 승인이 모두 있어야 한다.
#
# 🔴 기존 서비스(온담이·이음이) 채널을 재사용하지 말 것. 새 채널을 따로 판다.
#   토큰   LINE Developers > 채널 > Messaging API > Channel access token (long-lived)
#   수신자 LINE Developers > 채널 > Basic settings > Your user ID
#          이 값으로 보내면 본인에게만 간다. 비워 두면 실발송을 하지 않는다.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
LINE_SEND_ENABLED=false

# 카드 이미지는 공개 https 주소여야 LINE 이 받는다. 로컬 파일은 못 보낸다.
PUBLIC_BASE_URL=https://cardnews.dodami-ai.com

# ── 종료 조건 (PRD 3장) ─────────────────────────────────────
MAX_RETRY_PER_STEP=3
MAX_LOOP_ITERATIONS=30
MAX_RUN_SECONDS=600
MAX_IMAGE_CALLS=8

# Gemini 무료 티어 — 과금은 없고 429만 난다
MAX_LLM_CALLS_PER_RUN=40
MAX_LLM_CALLS_PER_DAY=300

# OpenAI — 기관 지급 크레딧 $5. 앱이 먼저 멈춘다
MAX_USD_PER_RUN=0.30
MAX_USD_TOTAL=3.00

# ── 경로 ────────────────────────────────────────────────────
DB_PATH=data/app.db
RUNS_DIR=runs
OUTPUT_DIR=output
